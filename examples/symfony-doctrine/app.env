# A Symfony app with Doctrine migrations, served by FrankenPHP from the volume, as switchyard
# runs it. Render and apply:
#   switchyard manifests --config app.env | kubectl apply -f -
# Values are taken literally: no shell expansion. Every key: README.md of switchyard.
APP=shop
NAMESPACE=shop
# runs the deploy, quick and rollback Jobs: needs bash, kubectl, curl and awk
IMAGE=docker.io/alpine/k8s:1.33.4
# runs the hooks on the release: the app's own image, with git and composer
BUILD_IMAGE=ghcr.io/example/shop-base:1
TZ=Europe/Berlin

# the two Deployments and their Services (slots.yaml)
SLOT_A=shop-a
SLOT_B=shop-b
PORT=8080
CODE_VOLUME=code
RELEASES_SIZE=10Gi

REPLICAS=2
STEPS=10 50
PAUSE=120
KEEP=5
# every canary step requests these from both slots, round after round, so a quiet site is tested too
HOST=shop.example.org
FORWARDED_PROTO=https
HEALTH=/health
PAGES=/ /products /login /health

# the scheduler runs from the live release
FOLLOWERS=cronjob/shop-cron
RELEASE_ENV=APP_RELEASE
RELEASE_VALUE={commit}

ROUTER=caddy
CADDY_ADMIN=http://caddy-admin.caddy:2019
CADDY_CONFIGMAP=caddy/caddyfile
CADDY_COOKIE=shop_slot

BUILD_MOUNT=/app
BUILD_ENV_FROM=configmap/shop-env secret/shop
BUILD_ENV_APP_ENV=prod
BUILD_MEMORY=2Gi
